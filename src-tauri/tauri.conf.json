{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DATES",
  "version": "1.1.0",
  "identifier": "com.dates.reminder",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DATES",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 480,
        "maxWidth": 560,
        "maxHeight": 780,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:dates.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNzJDQzhDRDBFNEIzNDcKUldSSHMrVFFqTXh5b3ExcHg1Nk01SjZQSGJISklya3lYSnhzTzY4NjdaTWljem9WbDRJTlRLbkgK",
      "endpoints": [
        "https://github.com/sokol040201/dates/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
